{
  "name": "no-chan",
  "version": "0.2.0",
  "description": "A sprite-animated girl for React + Vite: drag her, drop her, let her react to your app's events and show your notices on her phone.",
  "keywords": [
    "react",
    "mascot",
    "kanban-musume",
    "anime",
    "sprite-animation",
    "vite",
    "typescript"
  ],
  "homepage": "https://github.com/YoRHazero/no-chan#readme",
  "bugs": "https://github.com/YoRHazero/no-chan/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoRHazero/no-chan.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
